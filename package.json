{
  "name": "missiv-monorepo",
  "version": "0.0.0",
  "description": "A server/client for messages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "ldenv": "^0.3.12",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "set-defaults": "^0.0.5",
    "syncpack": "^13.0.3",
    "zellij-launcher": "^0.0.1"
  },
  "scripts": {
    "prepare": "set-defaults .vscode",
    "preinstall": "npx only-allow pnpm",
    "---------------------- INSTALL ----------------------": "",
    "sync-deps": "syncpack fix-mismatches && pnpm -r format:fix",
    "---------------------- FORMAT ----------------------": "",
    "format": "prettier --write . && pnpm -r format",
    "format:check": "prettier --check . && pnpm -r format:check",
    "---------------------- TEST ----------------------": "",
    "client:test": "pnpm --filter @missiv/client test",
    "cf-worker:test": "pnpm --filter @missiv/cf-worker test",
    "test": "pnpm -r test run",
    "---------------------- DEV ----------------------": "",
    "client:dev": "pnpm --filter @missiv/client dev",
    "client:dev:build": "pnpm --filter @missiv/client dev:build",
    "cf-worker:dev": "pnpm --filter @missiv/cf-worker dev",
    "bun:dev": "pnpm --filter @missiv/bun dev",
    "bun:build:watch": "pnpm --filter @missiv/bun build:watch",
    "nodejs:build:watch": "pnpm --filter missiv build:watch",
    "server:dev": "pnpm --filter @missiv/server dev",
    "common:dev": "pnpm --filter @missiv/common dev",
    "---------------------- PUBLISH ----------------------": "",
    "check:packaging": "node scripts/check-packaging.mjs",
    "release:ci": "pnpm check:packaging && pnpm format:check && pnpm build && pnpm test && pnpm changeset publish",
    "---------------------- DEPLOY ----------------------": "",
    "build": "ldenv pnpm run -r build",
    "serve": "pnpm run --filter @missiv/client serve",
    "deploy:cf": "pnpm run --filter @missiv/cf-worker deploy",
    "---------------------- RUN FULL LOCAL SETUP ----------------------": "",
    "stop": "zellij kill-session $npm_package_name",
    "start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
  }
}
