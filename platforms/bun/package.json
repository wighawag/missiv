{
  "name": "@missiv/bun",
  "version": "0.5.2",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/missiv.git",
    "directory": "platforms/bun"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "bin": {
    "missiv-bun": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    ".env.default"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "hono": "^4.7.5",
    "ldenv": "^0.3.12",
    "@missiv/common": "workspace:^",
    "@missiv/server": "workspace:^",
    "named-logs-context": "^0.1.1",
    "remote-sql": "^0.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "as-soon": "^0.0.11",
    "bun-types": "^1.2.5",
    "prettier": "^3.5.3",
    "set-defaults": "^0.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "prepare": "set-defaults .env.default",
    "build": "tsc",
    "build:watch": "as-soon -w src tsc",
    "dev": "SESSION_SECRET=${SESSION_SECRET:-missiv-dev-only-session-secret} bun run --hot src/cli.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node scripts/test.mjs"
  }
}
