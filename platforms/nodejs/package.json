{
  "name": "missiv",
  "version": "0.5.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/missiv.git",
    "directory": "platforms/nodejs"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "missiv": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    ".env.default"
  ],
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@libsql/client": "^0.15.0",
    "commander": "^13.1.0",
    "hono": "^4.7.5",
    "ldenv": "^0.3.12",
    "@missiv/server": "workspace:^",
    "named-logs-context": "^0.1.1",
    "remote-sql-libsql": "^0.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "as-soon": "^0.0.11",
    "delegated-identity": "^0.2.0",
    "@missiv/client": "workspace:*",
    "@missiv/common": "workspace:*",
    "prettier": "^3.5.3",
    "set-defaults": "^0.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "viem": "^2.23.13",
    "vitest": "^3.0.9"
  },
  "scripts": {
    "prepare": "set-defaults .env.default",
    "dev": "SESSION_SECRET=${SESSION_SECRET:-missiv-dev-only-session-secret} tsx watch src/cli.ts --port 30042",
    "build": "tsc",
    "build:watch": "as-soon -w src tsc",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest"
  }
}
