{
	"name": "@missiv/client",
	"version": "0.4.1",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/missiv.git",
		"directory": "packages/client"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@noble/ciphers": "^1.2.1",
		"@noble/curves": "^1.9.7",
		"@noble/hashes": "^1.7.1",
		"@scure/base": "^1.2.4",
		"delegated-identity": "^0.2.0",
		"@missiv/common": "workspace:^"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@etherplay/connect": "^0.19.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.20.1",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@zag-js/dialog": "^1.4.2",
		"@zag-js/svelte": "^1.4.2",
		"as-soon": "^0.0.11",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.9",
		"svelte": "^5.23.2",
		"svelte-check": "^4.1.5",
		"typescript": "^5.8.2",
		"vite": "^6.2.2",
		"vitest": "^3.0.9"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run check && vite build && npm run package",
		"dev:build": "as-soon -w src/lib pnpm build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"format:check": "prettier --check .",
		"format:write": "prettier --write ."
	}
}
